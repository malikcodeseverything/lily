{
  "name": "lily",
  "private": true,
  "version": "0.1.0",
  "description": "Sculpt glowing 3D point-cloud objects in mid-air with your hands. Real-time hand tracking in the browser.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "predev:https": "node scripts/copy-wasm.mjs",
    "dev:https": "vite --mode https",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-models": "node scripts/fetch-models.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
